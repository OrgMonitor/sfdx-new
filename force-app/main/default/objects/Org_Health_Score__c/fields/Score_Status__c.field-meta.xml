<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Score_Status__c</fullName>
    <description>Healthy / Warning / Critical / At Risk</description>
    <externalId>false</externalId>
    <formula>IF(Overall_Score__c &gt;= 80, &apos;✅ Healthy&apos;,
IF(Overall_Score__c &gt;= 60, &apos;⚠️ Warning&apos;,
IF(Overall_Score__c &gt;= 40, &apos;🔶 At Risk&apos;,
&apos;🚨 Critical&apos;)))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Healthy / Warning / Critical / At Risk</inlineHelpText>
    <label>Score Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
