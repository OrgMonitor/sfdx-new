<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Compliant_Changes_Are_Authorised</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(Non_Compliant__c), OR(NOT(ISPICKVAL(Lifecycle_Status__c, &quot;Closed&quot;)), NOT(ISPICKVAL(Review_Outcome__c, &quot;Authorised&quot;))))</errorConditionFormula>
    <errorMessage>A compliant change must be Closed and Authorised.</errorMessage>
</ValidationRule>
