<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Review_Requires_Outcome</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Non_Compliant__c, ISPICKVAL(Lifecycle_Status__c, &quot;Closed&quot;), ISBLANK(TEXT(Review_Outcome__c)))</errorConditionFormula>
    <errorMessage>A closed non-compliant change must have a Review Outcome.</errorMessage>
</ValidationRule>
